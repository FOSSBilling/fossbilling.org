---
import { ChevronDown, Menu, X } from '@lucide/astro';
import ThemeToggle from './ThemeToggle.astro';
import BrandIcon from './BrandIcon.astro';

const navItems = [
  {
    title: 'Documentation',
    href: 'https://docs.fossbilling.org/',
    external: true,
  },
  { title: 'Downloads', href: '/downloads/' },
  { title: 'Demo', href: '/demo/' },
  {
    title: 'Translate',
    href: 'https://translate.fossbilling.org/',
    external: true,
  },
];

const mobileNavItems = [
  ...navItems,
  {
    title: 'GitHub',
    href: 'https://github.com/FOSSBilling/FOSSBilling',
    external: true,
  },
  { title: 'Discord', href: '/discord', external: true },
];

const donationLinks = [
  {
    title: 'Open Collective',
    href: 'https://opencollective.com/FOSSBilling',
  },
  {
    title: 'GitHub Sponsors',
    href: 'https://github.com/sponsors/FOSSBilling',
  },
];

const currentPath = Astro.url.pathname;
---

<header class="relative z-30 w-full print:hidden">
  <div class="absolute inset-0 -z-1 border-b border-gray-200 dark:border-gray-800 backdrop-blur-md bg-white/70 dark:bg-[#111111]/70"></div>
  <nav
    class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-4 pl-[max(env(safe-area-inset-left),1.5rem)] pr-[max(env(safe-area-inset-right),1.5rem)]"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center" aria-label="Home page">
      <span class="logo"></span>
    </a>

    <div class="flex items-center gap-2 lg:gap-4">
      <ul class="hidden lg:flex items-center gap-4">
        {navItems.map(({ title, href, external }) => (
          <li>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              aria-current={href === currentPath ? 'page' : undefined}
              class="text-sm text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-gray-200 whitespace-nowrap transition-colors"
            >
              {title}
            </a>
          </li>
        ))}
        <li>
          <details class="group relative" data-nav-disclosure>
            <summary class="flex cursor-pointer list-none items-center gap-1 whitespace-nowrap text-sm text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-gray-200 transition-colors [&::-webkit-details-marker]:hidden">
              Donate
              <ChevronDown class="size-3 transition-transform group-open:rotate-180" />
            </summary>
            <ul class="absolute right-0 mt-2 w-48 rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-[#1a1a1a] shadow-lg py-1 z-50">
              {donationLinks.map(({ title, href }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block px-4 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-800"
                  >
                    {title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>

      <div class="hidden lg:block empty:hidden">
        <slot name="extras" />
      </div>

      <a
        href="/discord"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Discord"
        class="hidden lg:block text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
      >
        <BrandIcon name="discord" class="h-5 w-5" />
      </a>

      <ThemeToggle />

      <details class="group lg:hidden" data-nav-disclosure>
        <summary
          aria-label="Menu"
          class="block cursor-pointer list-none p-2 text-gray-600 dark:text-gray-400 [&::-webkit-details-marker]:hidden"
        >
          <Menu class="size-6 group-open:hidden" />
          <X class="hidden size-6 group-open:block" />
        </summary>
        <ul class="absolute inset-x-0 top-full flex max-h-[50dvh] flex-col gap-2 overflow-y-auto border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-[#111111] p-4">
          {mobileNavItems.map(({ title, href, external }) => (
            <li>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                aria-current={href === currentPath ? 'page' : undefined}
                class="block text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 py-1"
              >
                {title}
              </a>
            </li>
          ))}
          <li>
            <span class="text-sm font-medium text-gray-900 dark:text-gray-100">
              Donate
            </span>
            <ul class="ml-4 flex flex-col gap-1 mt-1">
              {donationLinks.map(({ title, href }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 py-1"
                  >
                    {title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  const disclosures = document.querySelectorAll<HTMLDetailsElement>(
    '[data-nav-disclosure]',
  );

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    const target = event.target;
    for (const disclosure of disclosures) {
      if (!disclosure.contains(target)) disclosure.open = false;
    }
  });

  for (const disclosure of disclosures) {
    disclosure.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && disclosure.open) {
        disclosure.open = false;
        disclosure.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .logo {
    display: block;
    width: 161.5px;
    aspect-ratio: 266.29333 / 54;
    background-image: url('../assets/logo-light.svg');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }

  :global(.dark) .logo {
    background-image: url('../assets/logo-dark.svg');
  }
</style>
