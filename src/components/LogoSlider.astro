---
const logos = [
  { name: 'cPanel', src: '/img/logos/cpanel.svg' },
  { name: 'Plesk', src: '/img/logos/plesk.svg' },
  { name: 'DirectAdmin', src: '/img/logos/directadmin.svg' },
  { name: 'ISPConfig', src: '/img/logos/ispconfig.png' },
  { name: 'HestiaCP', src: '/img/logos/hestiacp.svg' },
  { name: 'PayPal', src: '/img/logos/paypal.svg' },
  { name: 'Stripe', src: '/img/logos/stripe.svg' },
  { name: 'Mollie', src: '/img/logos/mollie.svg' },
  { name: 'Namecheap', src: '/img/logos/namecheap.svg' },
];
---

<div class="logo-slider relative overflow-hidden py-8">
  <div class="marquee-track flex whitespace-nowrap">
    {[...logos, ...logos].map((logo, i) => (
      <div
        class="mx-8 flex items-center justify-center"
        style="height: 32px; min-width: 150px;"
        aria-hidden={i >= logos.length ? 'true' : undefined}
      >
        <img
          src={logo.src}
          alt={i < logos.length ? logo.name : ''}
          class="logo-img transition-all duration-300"
          style="height: 100%; width: auto; object-fit: contain;"
        />
      </div>
    ))}
  </div>
</div>

<style>
  @keyframes scroll-marquee {
    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track {
    width: max-content;
    animation: scroll-marquee 60s linear infinite;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  .logo-img {
    opacity: 0.9;
    transition: all 0.3s;
    /* Light mode: dark gray logos by default */
    filter: brightness(0) invert(0.1);
    /* near-black */
  }

  /* Dark mode: white logos */
  :global(.dark) .logo-img {
    filter: brightness(0) invert(1);
    /* pure white */
  }

  /* Hover effect (gray in both modes) */
  .logo-img:hover {
    filter: brightness(0) invert(0.6);
    /* gray tone */
  }

  .logo-slider::before,
  .logo-slider::after {
    content: '';
    position: absolute;
    top: 0;
    width: 5rem;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .logo-slider::before {
    left: 0;
    background: linear-gradient(
      to right,
      var(--features-bg-color) 0%,
      transparent 100%
    );
  }

  .logo-slider::after {
    right: 0;
    background: linear-gradient(
      to left,
      var(--features-bg-color) 0%,
      transparent 100%
    );
  }
</style>
