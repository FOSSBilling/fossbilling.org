---
import { Moon, Sun } from '@lucide/astro';
---

<button
  type="button"
  data-theme-toggle
  hidden
  aria-label="Dark mode"
  aria-pressed="false"
  class="p-2 text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
>
  <Moon size={20} class="dark:hidden" />
  <Sun size={20} class="hidden dark:block" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    '[data-theme-toggle]',
  );
  const root = document.documentElement;

  if (button) {
    button.setAttribute(
      'aria-pressed',
      String(root.classList.contains('dark')),
    );
    button.hidden = false;
    button.addEventListener('click', () => {
      const dark = root.classList.toggle('dark');
      button.setAttribute('aria-pressed', String(dark));
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        // The current page can still switch themes when storage is unavailable.
      }
    });
  }
</script>
