---
import { Info, TriangleExclamationPoint } from '@lucide/astro';

interface Props {
  type: 'info' | 'warning';
  title: string;
}

const { type, title } = Astro.props;
const warning = type === 'warning';
const Icon = warning ? TriangleExclamationPoint : Info;
---

<div
  class:list={[
    'rounded-lg border p-4 my-4',
    warning
      ? 'border-yellow-200 bg-yellow-50 dark:border-yellow-900 dark:bg-yellow-950'
      : 'border-blue-200 bg-blue-50 dark:border-blue-900 dark:bg-blue-950',
  ]}
>
  <div
    class:list={[
      'flex items-center gap-2 font-semibold mb-1',
      warning
        ? 'text-yellow-600 dark:text-yellow-400'
        : 'text-blue-600 dark:text-blue-400',
    ]}
  >
    <Icon size={20} />
    <span>{title}</span>
  </div>
  <div class="text-sm text-gray-700 dark:text-gray-300 [&_a]:text-blue-600 dark:[&_a]:text-blue-400 [&_a]:underline">
    <slot />
  </div>
</div>
