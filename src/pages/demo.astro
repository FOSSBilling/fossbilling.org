---
import { Check } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import DemoCards from '../components/DemoCards.astro';
import Callout from '../components/Callout.astro';

const features = [
  'Create products & services',
  'Manage client accounts',
  'Configure payment gateways',
  'Handle support tickets',
  'Generate invoices',
  'Explore the client portal',
];
---

<Base title="Demo">
  <div class="home-content">
    <div class="content-container">
      <h1 class="headline">Try FOSSBilling</h1>
      <p class="subtitle mt-4">
        Explore the admin panel and client area without installing anything.
      </p>

      <Callout type="info" title="Demo Environment">
        The demo resets periodically. Any changes you make will be temporary.
      </Callout>
    </div>

    <div class="features-container">
      <div
        class="content-container"
        style="padding-top: 2rem; padding-bottom: 2rem;"
      >
        <DemoCards />

        <div class="demo-features-section">
          <h3>What you can try</h3>
          <ul class="demo-features-grid">
            {features.map((feature) => (
              <li class="demo-feature-item">
                <Check />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .demo-features-section {
    max-width: 900px;
    margin: 2rem auto 0;
  }

  .demo-features-section h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--card-heading);
    text-align: center;
  }

  .demo-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 700px) {
    .demo-features-grid {
      grid-template-columns: 1fr;
    }
  }

  .demo-feature-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #4b5563;
    padding: 0.5rem 0.75rem;
    background: var(--card-bg);
    border-radius: 0.5rem;
    border: 1px solid var(--card-border);
  }

  :global(.dark) .demo-feature-item {
    color: #d1d5db;
  }

  .demo-feature-item :global(svg) {
    color: #2563eb;
    flex-shrink: 0;
  }

  :global(.dark) .demo-feature-item :global(svg) {
    color: #60a5fa;
  }
</style>
