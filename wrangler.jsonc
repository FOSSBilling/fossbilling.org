{
  "name": "fossbilling-org",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    },
    "issues": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "production"
  },
  "routes": [
    {
      "pattern": "fossbilling.org",
      "zone_name": "fossbilling.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash"
  },
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview"
    }
  }
}
