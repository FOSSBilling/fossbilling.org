  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "cf-typegen": "wrangler types",
    "cf-deploy": "wrangler deploy",
    "cf-preview": "wrangler preview",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write \"{src,public,tests}/**/*.{astro,css,js,json,mjs,ts}\" \"*.{json,mjs,ts}\" \".github/**/*.{yml,yaml}\" \"*.yaml\"",
    "format:check": "prettier --check \"{src,public,tests}/**/*.{astro,css,js,json,mjs,ts}\" \"*.{json,mjs,ts}\" \".github/**/*.{yml,yaml}\" \"*.yaml\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.24.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "date-fns": "^4.4.0",
    "satori": "^0.57.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
